# Google AI Studio에서 발급한 Gemini API Key입니다.
# 이 값은 Server에서만 사용되며 NEXT_PUBLIC_ 접두사를 붙이지 않습니다.
GOOGLE_GENERATIVE_AI_API_KEY=

# 선택값이 없는 요청에만 쓰는 기본 모델입니다. 허용된 무료 등급 모델 외의 값은 무시합니다.
# 비용을 0원으로 유지하려면 API Key가 연결된 프로젝트 자체가 무료 등급이어야 합니다.
GEMINI_MODEL=gemini-3.6-flash

# Vercel Storage > Blob에서 만든 비공개 Store의 Read/Write Token입니다.
# 설정하면 검토된 Persona 피드백이 브라우저 밖의 비공개 저장소에도 동기화됩니다.
# NEXT_PUBLIC_ 접두사를 붙이지 말고, Vercel Production/Preview 환경 변수에도 등록하세요.
BLOB_READ_WRITE_TOKEN=
